# ==============================================================================
# SonarLIC - Variables de Entorno de Configuración
# ==============================================================================

# Entorno: development | production
ENVIRONMENT=development

# 1. ClickHouse OLAP Database
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secure_pass_change_me
CLICKHOUSE_DB=radar_db

# 2. Redis Cache & Celery Broker
REDIS_URL=redis://redis:6379/0

# 3. Supabase Auth & Relational DB
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 4. Ingesta Datos Abiertos Colombia (SODA API)
# Token opcional de datos.gov.co para evitar throttling / 429
SODA_APP_TOKEN=

# 5. Inteligencia Artificial (OpenAI / DeepSeek / Anthropic)
OPENAI_API_KEY=sk-proj-...

# 6. Dominios y URLs Externas
DOMAIN_NAME=localhost
NEXT_PUBLIC_API_URL=http://localhost
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
